@model bool
@{
    // Model = true cuando es para el personal (se pide el usuario) y false para pacientes (se pide el correo)
    bool personal = Model;
}

<div class="tt-modal-overlay" id="recuperarModal">
    <div class="tt-modal-box" role="dialog" aria-modal="true" aria-labelledby="rec-titulo">
        <button type="button" class="tt-modal-x" aria-label="Cerrar" data-modal-cerrar>×</button>

        <div id="rec-v1">
            <div class="tt-modal-icon suave" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
            </div>
            <h2 id="rec-titulo">Recuperar contraseña</h2>
            <p>@(personal ? "Ingresá tu usuario y te enviamos un enlace al correo registrado para crear una contraseña nueva." : "Ingresá el correo con el que te registraste y te enviamos un enlace para crear una contraseña nueva.")</p>

            <form method="post" asp-page-handler="Recuperar" id="rec-form" novalidate>
                <div class="tt-field">
                    <label for="rec-dato">@(personal ? "Usuario" : "Correo electrónico")</label>
                    <input id="rec-dato" name="dato" type="@(personal ? "text" : "email")" maxlength="100" autocomplete="@(personal ? "username" : "email")"
                           placeholder="@(personal ? "Ej: nombre.apellido" : "Ej: ana.perez@mail.com")" data-foco />
                </div>
                <div class="tt-msg-error" id="rec-err" role="alert"></div>
                <button type="submit" class="tt-button tt-button-red tt-modal-boton" id="rec-enviar" disabled>ENVIAR ENLACE</button>
            </form>
            <button type="button" class="tt-modal-volver" data-modal-cerrar>Volver a iniciar sesión</button>
        </div>

        <div id="rec-v2" hidden>
            <div class="tt-modal-icon suave ok" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            </div>
            <h2>Revisá tu correo</h2>
            <p>Si @(personal ? "el usuario" : "el correo") <b id="rec-eco"></b> está registrado, te enviamos un enlace al correo asociado para crear una contraseña nueva. Puede demorar unos minutos.</p>
            <button type="button" class="tt-button tt-button-red tt-modal-boton" data-modal-cerrar data-foco>VOLVER A INICIAR SESIÓN</button>
            <p class="tt-nota">El enlace vence en 1 hora. Si no lo ves, revisá la carpeta de spam.</p>
        </div>
    </div>
</div>

<script>
    (function () {
        var personal = @(personal ? "true" : "false");
        var ov = document.getElementById('recuperarModal'), form = document.getElementById('rec-form');
        var dato = document.getElementById('rec-dato'), btn = document.getElementById('rec-enviar'), err = document.getElementById('rec-err');
        var v1 = document.getElementById('rec-v1'), v2 = document.getElementById('rec-v2');
        function valido() { var v = dato.value.trim(); return personal ? v.length >= 3 : /^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/.test(v); }
        function revisar() { err.textContent = ''; btn.disabled = !valido(); }
        dato.addEventListener('input', revisar);
        ov.addEventListener('tt-abierto', function () {
            v1.hidden = false; v2.hidden = true; err.textContent = '';
            var login = document.getElementById(personal ? 'Usuario' : 'Correo');   // arranca con lo que ya escribió en el ingreso (se puede cambiar)
            dato.value = login ? login.value.trim() : '';
            revisar(); setTimeout(function () { dato.focus(); }, 40);
        });
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!valido()) { err.textContent = personal ? 'Ingresá tu usuario.' : 'Ingresá un correo electrónico válido.'; return; }
            btn.disabled = true;
            fetch(form.action, { method: 'POST', body: new FormData(form), headers: { 'X-Requested-With': 'fetch' }, credentials: 'same-origin' })
                .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                .then(function (j) {
                    if (!j.ok) { err.textContent = j.mensaje || 'No pudimos procesar el pedido. Probá de nuevo.'; btn.disabled = false; return; }
                    document.getElementById('rec-eco').textContent = dato.value.trim();
                    v1.hidden = true; v2.hidden = false;
                    var b = v2.querySelector('[data-foco]'); if (b) b.focus();
                })
                .catch(function () { err.textContent = 'No pudimos procesar el pedido. Probá de nuevo en unos minutos.'; btn.disabled = false; });
        });
    })();
</script>
