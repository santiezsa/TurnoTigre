@page
@model Web.Pages.Pacientes.IndexModel
@using Web.Datos
@{
    ViewData["Title"] = "Solicitar turno";
}

<partial name="_Mensajes" />

@if (Model.Titular == null)
{
    <div class="tt-info warn">⚠️ <span>Tu usuario no tiene una ficha de paciente asociada, por eso no podés sacar turnos desde acá. Si sos personal, usá el panel de Administrativo.</span></div>
}
else if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else
{
<section class="tt-booking" aria-labelledby="booking-title">
    <div class="tt-booking-heading">
        <h1 id="booking-title">Solicitar turno médico</h1>
    </div>

    <form method="get">
        @Html.AntiForgeryToken()
        <fieldset class="tt-booking-family">
            <legend>¿Para quién es el turno?</legend>
            <div class="tt-booking-family-grid">
                @foreach (var p in Model.Grupo)
                {
                    <label class="tt-booking-person">
                        <input type="radio" name="persona" value="@p.IdPaciente" checked="@(p.IdPaciente == Model.Persona)" onchange="ttBuscar(this.form)" />
                        <span class="tt-booking-avatar" aria-hidden="true">@p.Iniciales</span>
                        <span>
                            <strong>@p.Nombre</strong>
                            <small>@(p.IdPaciente == Model.Titular.IdPaciente ? "Yo" : p.Parentesco) · @p.Edad años</small>
                        </span>
                    </label>
                }
                <a class="tt-booking-add" asp-page="Familiares">+ Agregar familiar</a>
            </div>
        </fieldset>

        <partial name="_Reserva" model="Model.Reserva" />
    </form>
</section>
}
