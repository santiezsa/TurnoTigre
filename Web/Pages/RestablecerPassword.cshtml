@page
@model Web.Pages.RestablecerPasswordModel
@{
    ViewData["Title"] = "Crear contraseña nueva";
    ViewData["BodyClass"] = "publico";
}

<section class="tt-login" aria-label="Crear contraseña nueva">
    @if (!Model.Vigente)
    {
        <div class="tt-lg-cab">
            <div class="tt-modal-icon err" aria-hidden="true">✕</div>
            <h1>El enlace no sirve</h1>
            <p>Venció o ya fue usado. Pedí uno nuevo desde "¿Olvidaste tu contraseña?".</p>
        </div>
        <div class="tt-lg-cambio">
            <a asp-page="/Ingresar" class="tt-btn-sec">Ir al ingreso</a>
            <a asp-page="/IngresarPersonal" class="tt-lg-enlace">Soy personal del CAPS</a>
        </div>
    }
    else
    {
        <div class="tt-lg-cab">
            <h1>Elegí tu contraseña nueva</h1>
            <p>Tiene que tener al menos 8 caracteres, con mayúscula, minúscula y número.</p>
        </div>

        @if (Model.Error != null)
        {
            <div class="tt-aviso-datos" hidden data-tipo="err" data-titulo="No se pudo cambiar la contraseña" data-texto="@Model.Error"></div>
        }

        <form method="post" data-habilitar>
            <input type="hidden" asp-for="Token" />
            <div class="tt-field">
                <label asp-for="Nueva">Contraseña nueva</label>
                <input asp-for="Nueva" type="password" autocomplete="new-password" maxlength="64" placeholder="Mínimo 8 caracteres" required />
            </div>
            <div class="tt-field">
                <label asp-for="Repetir">Repetí la contraseña nueva</label>
                <input asp-for="Repetir" type="password" autocomplete="new-password" maxlength="64" placeholder="Repetí la contraseña" required />
            </div>
            <button type="submit" class="tt-button tt-button-red tt-login-submit">GUARDAR CONTRASEÑA</button>
        </form>
    }
</section>
