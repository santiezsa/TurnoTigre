@page
@model Web.Pages.CambiarPasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="tt-login" aria-label="Cambiar contraseña">

    @if (Model.EsPrimerIngreso)
    {
        <div class="alert alert-warning">
            Es tu primer ingreso (o tu contraseña fue restablecida). Por seguridad, elegí una contraseña nueva para continuar.
        </div>
    }

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <form method="post">
        <div class="tt-field">
            <label asp-for="Actual">Contraseña actual</label>
            <input asp-for="Actual" type="password" autocomplete="current-password" required />
            <span asp-validation-for="Actual" class="text-danger"></span>
        </div>

        <div class="tt-field">
            <label asp-for="Nueva">Contraseña nueva</label>
            <input asp-for="Nueva" type="password" autocomplete="new-password" required />
            <span asp-validation-for="Nueva" class="text-danger"></span>
            <small class="text-muted">Mínimo 8 caracteres, con mayúscula, minúscula y número.</small>
        </div>

        <div class="tt-field">
            <label asp-for="Repetir">Repetí la contraseña nueva</label>
            <input asp-for="Repetir" type="password" autocomplete="new-password" required />
            <span asp-validation-for="Repetir" class="text-danger"></span>
        </div>

        <button type="submit" class="tt-button tt-button-red tt-login-submit">GUARDAR</button>
    </form>
</section>
