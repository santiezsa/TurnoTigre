@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="tt-welcome">
    <h1>Bienvenido a Turno Tigre</h1>

    <p>
        Solicitá y gestioná tus turnos médicos
        en los centros de salud del Municipio de Tigre.
    </p>

    <p>
        Iniciá sesión para acceder.
        Si todavía no tenés una cuenta, registrate para comenzar.
    </p>

    <div class="tt-welcome-actions">
        <a class="tt-button tt-button-blue" href="/Ingresar">
            Iniciar sesión
        </a>
        <a class="tt-button tt-button-outline" href="/Registro">
            Crear cuenta
        </a>
    </div>
</section>