@page
@model Web.Pages.MisDatosModel
@{
    ViewData["Title"] = "Mis datos";
}

<partial name="_Mensajes" />
@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }

<h1 class="tt-page-title">Mis datos</h1>
<p class="tt-lead">Revisá y actualizá tus datos de contacto. El usuario y el rol los define el administrador del sistema.</p>

<form method="post" class="tt-card">
    <div class="tt-grid g2">
        <div><label class="form-label">Usuario</label><input class="form-control" value="@Model.NombreUsuario" disabled /></div>
        <div><label class="form-label">Rol</label><input class="form-control" value="@Model.Rol" disabled /></div>
        <div><label class="form-label">Nombre *</label><input name="nombre" class="form-control" maxlength="40" value="@Model.Nombre" required /></div>
        <div><label class="form-label">Apellido *</label><input name="apellido" class="form-control" maxlength="40" value="@Model.Apellido" required /></div>
        <div><label class="form-label">Correo electrónico *</label><input name="email" type="email" class="form-control" maxlength="80" value="@Model.Email" required /></div>
        <div><label class="form-label">Teléfono</label><input name="telefono" class="form-control" inputmode="tel" maxlength="20" value="@Model.Telefono" /></div>
    </div>
    <div class="tt-footer-actions">
        <a class="tt-button tt-button-outline" asp-page="/CambiarPassword">Cambiar contraseña</a>
        <button type="submit" class="tt-button tt-button-red">Guardar cambios</button>
    </div>
</form>
