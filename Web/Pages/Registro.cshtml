@page
@model Web.Pages.RegistroModel
@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["BodyClass"] = "publico";
}

<section class="tt-register">
    <h1>Registrate como paciente</h1>
    <p class="tt-login-description">
        Necesitás tener domicilio en el partido de Tigre.
    </p>

    @if (Model.Error != null)
    {
        <div class="tt-aviso-datos" hidden data-tipo="err" data-titulo="No se pudo crear la cuenta" data-texto="@Model.Error"></div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post">
        <div class="tt-register-grid">

            <div class="tt-field">
                <label asp-for="Nombre">Nombre</label>
                <input asp-for="Nombre"
                       type="text" autocomplete="given-name"
                       maxlength="100"
                       placeholder="Ej.: Maria"
                       required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Apellido">Apellido</label>
                <input asp-for="Apellido"
                       type="text" autocomplete="family-name"
                       maxlength="100"
                       placeholder="Ej.: Perez"
                       required />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Dni">Número de DNI</label>
                <input asp-for="Dni"
                       type="text" inputmode="numeric"
                       pattern="[0-9]{7,8}" maxlength="8"
                       title="Ingresá entre 7 y 8 números, sin puntos"
                       placeholder="Sin puntos" required />
                <span asp-validation-for="Dni" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="FechaNacimiento">Fecha de nacimiento</label>
                <input asp-for="FechaNacimiento"
                       type="date" autocomplete="bday"
                       required />
                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Sexo">Sexo</label>
                <select asp-for="Sexo" required>
                    <option value="">Seleccioná...</option>
                    <option value="Femenino">Femenino</option>
                    <option value="Masculino">Masculino</option>
                    <option value="X">X</option>
                </select>
                <span asp-validation-for="Sexo" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Localidad">Localidad</label>
                <select asp-for="Localidad" required>
                    <option value="">Seleccioná...</option>
                    @foreach (var l in Dominio.Catalogos.LocalidadesTigre) { <option value="@l" selected="@(Model.Localidad == l)">@l</option> }
                </select>
                <span asp-validation-for="Localidad" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Calle">Calle</label>
                <input asp-for="Calle"
                       type="text"
                       maxlength="100"
                       placeholder="Ej.: Av. Liniers"
                       required />
                <span asp-validation-for="Calle" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Altura">Altura</label>
                <input asp-for="Altura"
                       type="text"
                       inputmode="numeric"
                       maxlength="10"
                       placeholder="Ej.: 2840"
                       required />
                <span asp-validation-for="Altura" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Telefono">Teléfono</label>
                <input asp-for="Telefono"
                       type="tel" autocomplete="tel"
                       maxlength="20" required />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Correo">Correo electrónico</label>
                <input asp-for="Correo"
                       type="email" autocomplete="email"
                       maxlength="100"
                       placeholder="nombre@correo.com"
                       required />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Contrasena">Contraseña</label>
                <input asp-for="Contrasena"
                       type="password"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="Contrasena" class="text-danger"></span>
            </div>

            <div class="tt-field">
                <label asp-for="Confirmacion">Confirmar contraseña</label>
                <input asp-for="Confirmacion"
                       type="password"
                       autocomplete="new-password"
                       required />
                <span asp-validation-for="Confirmacion" class="text-danger"></span>
            </div>
        </div>

        <button class="tt-button tt-button-red tt-register-submit"
                type="submit">
            Crear cuenta
        </button>
    </form>

    <div class="tt-lg-cambio mt-3">
        <span>¿Ya tenés cuenta?</span>
        <a asp-page="/Ingresar" class="tt-lg-enlace">Iniciá sesión</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}