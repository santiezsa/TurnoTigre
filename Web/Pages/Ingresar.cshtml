@page
@model Web.Pages.IngresarModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Panel del paciente · Iniciar sesión";
    ViewData["BodyClass"] = "publico";
    bool demo = Config.GetValue<bool>("Demo:MostrarCuentasDePrueba");
}

<section class="tt-login" aria-label="Ingreso de pacientes">

    <div class="tt-lg-cab">
        <h1>Ingreso de pacientes</h1>
        <p>Entrá para sacar y ver tus turnos médicos.</p>
    </div>

    @if (Model.Error != null)
    {
        <div class="tt-aviso-datos" hidden data-tipo="err" data-titulo="No pudimos iniciar sesión" data-texto="@Model.Error" data-foco="#Contrasena"></div>
    }

    <form method="post" data-habilitar>

        <div class="tt-field">
            <label asp-for="Correo">Correo electrónico</label>
            <input asp-for="Correo"
                   type="email"
                   autocomplete="username"
                   placeholder="Ej: ana.perez@mail.com"
                   required />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>

        <div class="tt-field">
            <label asp-for="Contrasena">Contraseña</label>
            <input asp-for="Contrasena"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Su contraseña"
                   required />
            <span asp-validation-for="Contrasena" class="text-danger"></span>
        </div>

        <div class="tt-recovery-row">
            <button type="button" class="tt-recovery-link" data-modal-abrir="recuperarModal">¿Olvidaste tu contraseña?</button>
        </div>

        <button type="submit" class="tt-button tt-button-red tt-login-submit">INGRESAR</button>
    </form>

    <div class="tt-lg-cambio">
        <div class="tt-lg-nueva">¿Es la primera vez que entrás?</div>
        <a asp-page="/Registro" class="tt-btn-sec">Crear mi cuenta</a>
        <a asp-page="/IngresarPersonal" class="tt-lg-enlace">Soy personal del CAPS</a>
    </div>

    @if (demo)
    {
        <p class="tt-lg-demo">Datos de prueba: <b>ana.perez@mail.com</b> · contraseña <b>Tigre2026</b></p>
    }
</section>

<partial name="_RecuperarPassword" model="false" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
